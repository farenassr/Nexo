{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Nexo": {
    "DevelopmentModuleGate": {
      "ActiveModules": [
        "restaurant"
      ]
    },
    "DevelopmentRestaurantPermissions": {
      "GrantedPermissions": [
        "restaurant.context.read",
        "restaurant.dashboard.read",
        "restaurant.reservations.read",
        "restaurant.reservations.manage",
        "restaurant.floorplan.read",
        "restaurant.setup.manage",
        "restaurant.floorplan.manage"
      ]
    }
  }
}
